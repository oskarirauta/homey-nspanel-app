  ],
  "name": {
    "en": "NSPanel"
  },
  "description": {
    "en": "Sonoff NSPanel"
  },
  "category": [
    "appliances"
  ],
  "tags": {
    "en": [
      "sonoff",
      "nspanel",
      "mqtt"
    ]
  },
  "permissions": [
    "homey:app:nl.scanno.mqtt"
  ],
  "images": {
    "small": "/assets/images/small.jpg",
    "large": "/assets/images/large.jpg",
    "xlarge": "/assets/images/xlarge.jpg"
  },
  "source": "https://github.com/DayS/homey-intex-spa",
