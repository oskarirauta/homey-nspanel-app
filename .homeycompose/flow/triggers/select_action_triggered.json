{
  "id": "select_action_triggered",
  "title": {
    "en": "Option selected from list on panel",
    "fi": "Valinta tehty valintalistasta paneelilla"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=nspanel"
    }
  ],
  "tokens": [
    {
      "name": "entity",
      "type": "string",
      "title": { "en": "Entity ID", "fi": "Kohteen ID" },
      "example": "home_state"
    },
    {
      "name": "option",
      "type": "string",
      "title": { "en": "Selected option", "fi": "Valittu vaihtoehto" },
      "example": "Kotona"
    },
    {
      "name": "index",
      "type": "number",
      "title": { "en": "Option index (0-based)", "fi": "Valinnan järjestysnumero (0-pohjainen)" },
      "example": 0
    }
  ]
}
