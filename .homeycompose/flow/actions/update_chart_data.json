{
  "id": "update_chart_data_action",
  "title": {
    "en": "Update chart data",
    "fi": "Päivitä kaavion tiedot"
  },
  "titleFormatted": {
    "en": "Update chart data on page [[page]] (data: [[data]], unit: [[unit]], ticks: [[ticks]])",
    "fi": "Päivitä kaavion tiedot sivulla [[page]] (data: [[data]], yksikkö: [[unit]], asteikko: [[ticks]])"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=nspanel"
    },
    {
      "name": "page",
      "type": "text",
      "required": false,
      "label": {
        "en": "Page ID (default: active / chart)",
        "fi": "Sivun ID (oletus: active / chart)"
      },
      "placeholder": {
        "en": "active",
        "fi": "active"
      },
      "title": {
        "en": "Page ID (default: active / chart)",
        "fi": "Sivun ID (oletus: active / chart)"
      }
    },
    {
      "name": "data",
      "type": "text",
      "required": true,
      "label": {
        "en": "New Datapoints",
        "fi": "Uudet arvot"
      },
      "placeholder": {
        "en": "5.2, 4.8, 7.5, 12.0...",
        "fi": "5.2, 4.8, 7.5, 12.0..."
      },
      "title": {
        "en": "New Datapoints",
        "fi": "Uudet arvot"
      }
    },
    {
      "name": "unit",
      "type": "text",
      "required": false,
      "label": {
        "en": "Y-axis Unit (optional)",
        "fi": "Y-akselin yksikkö (valinnainen)"
      },
      "placeholder": {
        "en": "c/kWh",
        "fi": "c/kWh"
      },
      "title": {
        "en": "Y-axis Unit (optional)",
        "fi": "Y-akselin yksikkö (valinnainen)"
      }
    },
    {
      "name": "ticks",
      "type": "text",
      "required": false,
      "label": {
        "en": "Y-axis Ticks (optional)",
        "fi": "Y-akselin asteikko (valinnainen)"
      },
      "placeholder": {
        "en": "50:100:150:200",
        "fi": "50:100:150:200"
      },
      "title": {
        "en": "Y-axis Ticks (optional)",
        "fi": "Y-akselin asteikko (valinnainen)"
      }
    }
  ],
  "hint": {
    "en": "Updates the panel display. Select Flow as the source in Studio to supply values yourself. A selected Homey, sensor or forecast source remains authoritative; this card does not change that source.",
    "fi": "Päivittää paneelin näyttötietoja. Valitse Studiossa lähteeksi Flow, kun syötät arvot itse. Valittu Homey-, anturi- tai ennustelähde pysyy ensisijaisena; tämä kortti ei vaihda lähdettä."
  }
}
