{
  "id": "set_alarm_state_action",
  "title": {
    "en": "Set alarm state",
    "fi": "Aseta hälyttimen tila"
  },
  "titleFormatted": {
    "en": "Set panel alarm state to [[state]]",
    "fi": "Aseta paneelin hälyttimen tilaksi [[state]]"
