  "title": {
    "en": "Set ventilation / fan state",
    "fi": "Aseta ilmanvaihdon / puhaltimen tila"
  },
  "titleFormatted": {
    "en": "Set fan/ventilation [[entity]] state: on=[[onoff]], speed=[[speed]], mode=[[mode]] (modes: [[modes]])",
