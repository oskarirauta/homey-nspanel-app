        "en": "Current mode name",
        "fi": "Nykyisen tilan nimi"
      }
    },
    {
      "name": "modes",
      "type": "text",
      "required": false,
      "label": {
        "en": "Modes list (? separated, optional)",
        "fi": "Tilalista (?-eroteltuna, valinnainen)"
      },
      "placeholder": {
        "en": "Poissa?Kotona?Tehostus?Takkatila",
        "fi": "Poissa?Kotona?Tehostus?Takkatila"
      },
      "title": {
        "en": "Modes list (? separated, optional)",
        "fi": "Tilalista (?-eroteltuna, valinnainen)"
      }
    }
