      "filter": "driver_id=nspanel"
    },
    {
      "name": "entity",
      "type": "text",
      "required": false,
      "label": {
        "en": "Entity ID (optional)",
        "fi": "Laitteen / entiteetin tunniste (valinnainen)"
      },
      "placeholder": {
        "en": "fan",
        "fi": "fan"
      },
      "title": {
        "en": "Entity ID (optional)",
        "fi": "Laitteen / entiteetin tunniste (valinnainen)"
      }
    },
    {
      "name": "onoff",
      "type": "checkbox",
      "required": false,
      "label": {
