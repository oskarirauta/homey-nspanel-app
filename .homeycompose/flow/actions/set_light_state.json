{
  "id": "set_light_state_action",
  "title": {
    "en": "Set light state on panel",
    "fi": "Aseta valon tila paneelilla"
  },
  "titleFormatted": {
    "en": "Set light [[entity]] state (on/off: [[onoff]], brightness: [[brightness]], temp: [[color_temp]])",
    "fi": "Aseta valon [[entity]] tila (virta: [[onoff]], kirkkaus: [[brightness]], lämpötila: [[color_temp]])"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=nspanel"
    },
    {
      "name": "entity",
      "type": "text",
      "required": true,
      "label": {
        "en": "Entity ID",
        "fi": "Valon tunniste"
      },
      "placeholder": {
        "en": "light",
        "fi": "light"
      },
      "title": {
        "en": "Entity ID",
        "fi": "Valon tunniste"
      }
    },
    {
      "name": "onoff",
      "type": "dropdown",
      "label": {
        "en": "Power state",
        "fi": "Virtatila"
      },
      "values": [
        {
          "id": "keep",
          "label": {
            "en": "Keep current state",
            "fi": "Säilytä nykyinen tila"
          }
        },
        {
          "id": "on",
          "label": {
            "en": "On",
            "fi": "Päällä"
          }
        },
        {
          "id": "off",
          "label": {
            "en": "Off",
            "fi": "Pois"
          }
        }
      ],
      "title": {
        "en": "Power state",
        "fi": "Virtatila"
      }
    },
    {
      "name": "brightness",
      "type": "number",
      "required": false,
      "min": 0,
      "max": 100,
      "label": {
        "en": "Brightness (optional, 0-100 %)",
        "fi": "Kirkkaus (valinnainen, 0-100 %)"
      },
      "placeholder": {
        "en": "80",
        "fi": "80"
      },
      "title": {
        "en": "Brightness (optional, 0-100 %)",
        "fi": "Kirkkaus (valinnainen, 0-100 %)"
      }
    },
    {
      "name": "color_temp",
      "type": "number",
      "required": false,
      "min": 0,
      "max": 100,
      "label": {
        "en": "Color temperature (optional, 0-100 %)",
        "fi": "Värilämpötila (valinnainen, 0-100 %)"
      },
      "placeholder": {
        "en": "50",
        "fi": "50"
      },
      "title": {
        "en": "Color temperature (optional, 0-100 %)",
        "fi": "Värilämpötila (valinnainen, 0-100 %)"
      }
    }
  ],
  "hint": {
    "en": "Updates the panel display. Select Flow as the source in Studio to supply values yourself. A selected Homey, sensor or forecast source remains authoritative; this card does not change that source.",
    "fi": "Päivittää paneelin näyttötietoja. Valitse Studiossa lähteeksi Flow, kun syötät arvot itse. Valittu Homey-, anturi- tai ennustelähde pysyy ensisijaisena; tämä kortti ei vaihda lähdettä."
  }
}
