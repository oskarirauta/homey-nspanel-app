        "fi": "Edellisen sivun kohde"
      }
    },
    {
      "name": "next_target",
      "type": "text",
      "required": false,
      "label": {
        "en": "Next page target",
        "fi": "Seuraavan sivun kohde"
      },
      "placeholder": {
        "en": "screensaver",
        "fi": "screensaver"
      },
      "title": {
        "en": "Next page target",
        "fi": "Seuraavan sivun kohde"
