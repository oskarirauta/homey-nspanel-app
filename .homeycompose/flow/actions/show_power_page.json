      "filter": "driver_id=nspanel"
    },
    {
      "name": "title",
      "type": "text",
      "required": false,
      "label": {
        "en": "Page Title",
        "fi": "Sivun otsikko"
      },
      "placeholder": {
        "en": "Power Flow",
        "fi": "Energiavirta"
      },
      "title": {
        "en": "Page Title",
        "fi": "Sivun otsikko"
      }
    },
    {
      "name": "home_power",
      "type": "text",
      "required": false,
      "label": {
        "en": "Home Power / Consumption",
        "fi": "Kodin teho / kulutus"
      },
      "placeholder": {
        "en": "2.4 kW",
        "fi": "2.4 kW"
      },
      "title": {
        "en": "Home Power / Consumption",
        "fi": "Kodin teho / kulutus"
      }
    },
    {
      "name": "home_title",
      "type": "text",
      "required": false,
      "label": {
        "en": "Home Title",
        "fi": "Keskuksen otsikko"
      },
      "placeholder": {
        "en": "Home",
        "fi": "Koti"
