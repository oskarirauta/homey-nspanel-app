{
  "id": "show_power_page_action",
  "title": {
    "en": "Show power flow card",
    "fi": "Näytä energiavirtaussivu"
  },
  "titleFormatted": {
    "en": "Show power card [[title]] (home: [[home_title]], power: [[home_power]], icon: [[home_icon]], color: [[home_color]], prev: [[prev_target]], next: [[next_target]])",
    "fi": "Näytä energiasivu [[title]] (koti: [[home_title]], teho: [[home_power]], kuvake: [[home_icon]], väri: [[home_color]], edellinen: [[prev_target]], seuraava: [[next_target]])"
  },
  "args": [
