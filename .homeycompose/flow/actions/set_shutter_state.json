{
  "id": "set_shutter_state_action",
  "title": {
    "en": "Set shutter state on panel",
    "fi": "Aseta verhon tila paneelilla"
  },
  "titleFormatted": {
    "en": "Set shutter [[entity]] state (position: [[position]], tilt: [[tilt]])",
    "fi": "Aseta verhon [[entity]] tila (asento: [[position]], säleasento: [[tilt]])"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=nspanel"
    },
    {
      "name": "entity",
      "type": "text",
      "required": true,
      "label": {
        "en": "Entity ID",
        "fi": "Verhon tunniste"
      },
      "placeholder": {
        "en": "shutter",
        "fi": "shutter"
      },
      "title": {
        "en": "Entity ID",
        "fi": "Verhon tunniste"
      }
    },
    {
      "name": "position",
      "type": "number",
      "required": false,
      "min": 0,
      "max": 100,
      "label": {
        "en": "Position (optional, 0-100 %)",
        "fi": "Asento (valinnainen, 0-100 %)"
      },
      "placeholder": {
        "en": "50",
        "fi": "50"
      },
      "title": {
        "en": "Position (optional, 0-100 %)",
        "fi": "Asento (valinnainen, 0-100 %)"
      }
    },
    {
      "name": "tilt",
      "type": "number",
      "required": false,
      "min": 0,
      "max": 100,
      "label": {
        "en": "Tilt angle (optional, 0-100 %)",
        "fi": "Säleasento (valinnainen, 0-100 %)"
      },
      "placeholder": {
        "en": "50",
        "fi": "50"
      },
      "title": {
        "en": "Tilt angle (optional, 0-100 %)",
        "fi": "Säleasento (valinnainen, 0-100 %)"
      }
    }
  ],
  "hint": {
    "en": "Updates the panel display. Select Flow as the source in Studio to supply values yourself. A selected Homey, sensor or forecast source remains authoritative; this card does not change that source.",
    "fi": "Päivittää paneelin näyttötietoja. Valitse Studiossa lähteeksi Flow, kun syötät arvot itse. Valittu Homey-, anturi- tai ennustelähde pysyy ensisijaisena; tämä kortti ei vaihda lähdettä."
  }
}
