        "fi": "Tila 1 / Toimintatila (esim. Lämmitys)"
      },
      "placeholder": {
        "en": "Lämmitys",
        "fi": "Lämmitys"
      },
      "title": {
        "en": "Mode 1 / Operation mode (e.g. Lämmitys)",
