{
  "id": "show_thermo_popup_action",
  "title": {
    "en": "Show thermostat popup",
    "fi": "Avaa termostaatin lisäsäätöikkuna"
  },
  "titleFormatted": {
    "en": "Open thermostat [[entity]] popup (mode 1: [[mode1]], options 1: [[modes1]], mode 2: [[mode2]], options 2: [[modes2]], mode 3: [[mode3]], options 3: [[modes3]])",
    "fi": "Avaa termostaatin [[entity]] lisäsäätöikkuna (tila 1: [[mode1]], valinnat 1: [[modes1]], tila 2: [[mode2]], valinnat 2: [[modes2]], tila 3: [[mode3]], valinnat 3: [[modes3]])"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=nspanel"
    },
    {
      "name": "entity",
      "type": "text",
      "required": false,
      "label": {
        "en": "Entity ID (default: thermo)",
        "fi": "Laitteen / entiteetin tunniste (oletus: thermo)"
      },
      "placeholder": {
        "en": "thermo",
        "fi": "thermo"
      },
      "title": {
        "en": "Entity ID (default: thermo)",
        "fi": "Laitteen / entiteetin tunniste (oletus: thermo)"
